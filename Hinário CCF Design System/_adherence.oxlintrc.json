{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/icons/**",
              "components/brand/**",
              "components/content/**",
              "components/forms/**",
              "components/ios-device/**",
              "components/navigation/**",
              "components/reader/**",
              "components/system/**",
              "ui_kits/hinario/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Figtree|Ysabeau Office))/i]",
        "message": "Font not provided by the design system. Available: Figtree, Ysabeau Office."
      },
      {
        "selector": "JSXOpeningElement[name.name='ABCAndMike'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|mode|text1|text2|key|ref|className|style|children)$/]",
        "message": "<ABCAndMike> doesn't accept that prop. Declared props: className, style, mode, text1, text2."
      },
      {
        "selector": "JSXOpeningElement[name.name='ABCAndMike'] > JSXAttribute[name.name='mode'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ABCAndMike> mode must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccessoryBarIPhoneFind'] > JSXAttribute > JSXIdentifier[name!=/^(?:className|style|mode|icon1|icon2|icon3|icon4|key|ref|className|style|children)$/]",
